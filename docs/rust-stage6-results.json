  "rawReports": 525,
  "decisions": {
    "R01": "Accept Rust input as the chosen implementation for subsequent migration stages, by explicit user decision. Cold hybrid gain is 23.3%; original warm and full-request thresholds are not met and remain documented. Develop input, Zstandard, Kiwi and index in the same Rust component. Production activation remains subject to integration and acceptance; Node fallback is retained.",
    "R02": "Accept Rust Zstandard as the chosen implementation for subsequent migration stages, by explicit user decision. Standalone gain is 80.5%; full load improves only 4.9% and median sampled combined peak RSS increases 5.9%. These limitations remain documented. Develop input, Zstandard, Kiwi and index in the same Rust component. Production activation remains subject to integration and acceptance; Node fallback is retained.",
    "direction": "R01 input and R02 Zstandard are accepted on Rust. Stage 07 R03 Kiwi is also accepted, as clarified by the user on 2026-10-26. Stage 08 continues the unified Rust pipeline; no blanket full-server rewrite decision was made. Measurements unchanged."
  },
  "limitations": [
    "macOS diagnostic measurements, not public MCP/browser/Kilo acceptance.",
    "No Windows measurements; step 15.",
    "Standalone peak RSS is kernel high-water; combined RSS is sampled simultaneous host+helper.",
    "Warm CPU covers 10 warmups + 100 measured iterations; one warm host per implementation/case.",
    "No N1 or alternative managed format; no forced GC or OS cache flush.",
    "Full 500000000-byte product budget not accepted; extension is not measured."
  ]
}
