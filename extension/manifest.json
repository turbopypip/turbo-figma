{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "turbo-figma",
  "version": "0.3.0",
  "description": "Connect an explicitly selected Figma tab to a local turbo-figma MCP server.",
  "permissions": ["debugger", "alarms", "storage", "activeTab", "scripting"],
  "action": { "default_title": "turbo-figma", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  }
}
